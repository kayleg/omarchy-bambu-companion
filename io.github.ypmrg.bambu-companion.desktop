[Desktop Entry]
Version=1.0
Type=Application
Name=Bambu Companion
GenericName=3D Printer Monitor
Comment=Monitor a Bambu Lab printer over the local network
Exec=omarchy-shell shell summon io.github.ypmrg.bambu-companion "{}"
TryExec=omarchy-shell
Icon=io.github.ypmrg.bambu-companion
Terminal=false
Categories=Utility;
Keywords=Bambu;3D Printer;Printer;Monitor;
StartupNotify=false
X-Bambu-Companion-Managed=true
