#!/bin/bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

for command_name in ruby bundle node g++ shellcheck; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    if [[ "$command_name" == node ]]; then
      echo "Bambu Companion checks require Node.js for the development-only viewport JavaScript harness." >&2
    elif [[ "$command_name" == g++ ]]; then
      echo "Bambu Companion checks require g++ for the development-only projection math tests." >&2
    else
      echo "Bambu Companion checks require the development command: $command_name" >&2
    fi
    exit 127
  fi
done

qmllint_command="${QMLLINT:-}"
if [[ -z "$qmllint_command" ]]; then
  qmllint_command="$(command -v qmllint || true)"
fi
if [[ -z "$qmllint_command" ]]; then
  for candidate in /usr/lib/qt6/bin/qmllint /usr/lib/qt6/libexec/qmllint; do
    if [[ -x "$candidate" ]]; then
      qmllint_command="$candidate"
      break
    fi
  done
fi
if [[ -z "$qmllint_command" ]]; then
  echo "Bambu Companion checks require the development command: qmllint" >&2
  exit 127
fi

omarchy_root="${OMARCHY_PATH:-/usr/share/omarchy}"
omarchy_shell="$omarchy_root/shell"
if [[ ! -d "$omarchy_shell/Commons" || ! -d "$omarchy_shell/Ui" ]]; then
  echo "Bambu Companion checks require an Omarchy shell at: $omarchy_shell" >&2
  exit 127
fi

qml_import_root="$(mktemp -d)"
trap 'rm -r -- "$qml_import_root"' EXIT
ln -s -- "$omarchy_shell" "$qml_import_root/qs"

bundle check
bundle exec ruby -Itest \
  -e 'Dir["test/**/*_test.rb"].sort.each { |file| require_relative file }'
test/system/launcher_test.sh
test/system/update_check_test.sh
ruby -rjson -e 'JSON.parse(File.read("manifest.json"))'

while IFS= read -r -d '' ruby_file; do
  ruby -c "$ruby_file"
done < <(find lib test -name '*.rb' -print0)
ruby -c daemon.rb
bash -n bambu-companion bambu-companion-update-check native/build \
  test/system/launcher_test.sh test/system/update_check_test.sh \
  test/support/fake-bundle bin/test
bundle exec rubocop --cache false daemon.rb lib test
shellcheck bambu-companion bambu-companion-update-check native/build \
  test/system/launcher_test.sh test/system/update_check_test.sh \
  test/support/fake-bundle test/support/fake-gem bin/test
"$qmllint_command" --max-warnings 0 --unused-imports warning \
  -I "$qml_import_root" ./*.qml

echo "All local Bambu Companion checks passed."
